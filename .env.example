# Copy to .env and fill in (everything is optional).
#
# There is NO ANTHROPIC_API_KEY: the AI layer uses claude-agent-sdk, which runs the
# `claude` CLI under the hood and reuses your subscription login. Prerequisite:
#   npm install -g @anthropic-ai/claude-code
#   claude        # log in once
# Not needed at all when running with --deterministic.

# Claude model used by the AI judges ("sonnet", "opus" or a full model id).
SAAS_EVAL_MODEL=sonnet

# Default crawl budget (pages visited in the browser) — overridable with --max-pages.
SAAS_EVAL_MAX_PAGES=12

# Where runs are stored (default: data/).
# SAAS_EVAL_DATA_DIR=data

# Optional credentials for --login (in-app evaluation). Never committed, never logged.
# SAAS_EVAL_USER=
# SAAS_EVAL_PASS=
